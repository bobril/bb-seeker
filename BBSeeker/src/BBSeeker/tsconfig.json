{
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "declaration": true,
    "strictFunctionTypes": true,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "preserveConstEnums": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noLib": false,
    "target": "ES2022",
    "rootDir": "ts",
    "outDir": "js",
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "exclude": [
    "ts/npmPackages/*",
"js/*"
  ]
}
